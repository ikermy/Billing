NODE_ENV=production
PORT=6001
CORS_ORIGINS=http://localhost:3000
ENABLE_SWAGGER=false
ENABLE_WATERFALL_WALLET=false
ENABLE_SAGA_KAFKA=false
ENABLE_DYNAMIC_PRICING=false
ENABLE_TOPUP_BONUS=false
ENABLE_LEGACY_BARCODE_NEW_BILLING=false

DATABASE_URL=postgresql://billing:change_me@127.0.0.1:5432/billing

JWT_ACCESS_SECRET=replace-with-32-plus-char-random-secret
INTERNAL_API_KEY=replace-with-32-plus-char-random-internal-key

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

KAFKA_ENABLED=false
KAFKA_CLIENT_ID=billing-service
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_GROUP_ID=billing-service

# Lago stores pricing, plans, subscriptions, and package metadata.
LAGO_URL=https://lago.example.com/api/v1
LAGO_API_KEY=change-me

# Real money operations should go through the dedicated wallet-balance service.
WALLET_BALANCE_URL=http://127.0.0.1:7000
WALLET_BALANCE_API_KEY=change-me
